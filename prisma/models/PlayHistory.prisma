model PlayHistory {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  trackId   String
  track     Track    @relation(fields: [trackId], references: [id])

  playedAt  DateTime @default(now())
  duration  Int?

  @@index([userId, playedAt])
  @@map("play_history")
}