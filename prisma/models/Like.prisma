model Like {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, trackId])
  @@index([trackId])
  @@map("likes")
}