{
    # TLS is terminated by Cloudflare; origin serves plain HTTP.
    auto_https off
}

:80 {
    @frontend host music-room.amblanch.com
    handle @frontend {
        reverse_proxy frontend:8081
    }

    @api host music-room-api.amblanch.com
    handle @api {
        reverse_proxy backend:3000
    }

    respond "Not found" 404
}