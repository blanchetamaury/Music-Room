{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"@/*": ["./*"]
		},
		"module": "preserve",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"target": "ES2023",
		"esModuleInterop": true,
		"types": ["node"]
	},
	"include": ["**/*.ts", "**/*.tsx"]
}
