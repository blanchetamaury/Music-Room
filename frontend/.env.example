# Copy to frontend/.env.
#
# Only EXPO_PUBLIC_* variables reach the app bundle, and Expo inlines their values at build
# time. Anything not prefixed with EXPO_PUBLIC_ is unreadable from the app, so no server
# secret belongs in this file.
#
# The OAuth client IDs and secrets are deliberately absent: the app never starts an
# authorization flow itself. It calls POST /auth/oauth/start and the server builds the
# provider URL, so those values live in backend/.env only.

# Base URL of the API, including the /api prefix.
# Android emulator: http://10.0.2.2:3000/api
# iOS simulator:   http://localhost:3000/api
# Physical device: http://<your-lan-ip>:3000/api
EXPO_PUBLIC_API_URL="http://localhost:3000/api"
