# Copy to backend/.env and fill in. Every value below is read by the server at boot.
# The two marked REQUIRED are validated on startup: the process refuses to start without
# them rather than silently falling back to an insecure default.

# --- REQUIRED ---------------------------------------------------------------

# REQUIRED. Connection string for PostgreSQL. Only the postgres driver is supported.
DATABASE_URL="postgresql://user:password@localhost:5432/music_room?schema=public"

# REQUIRED. At least 32 characters. Signs the session cookie and, unless
# TOKEN_ENCRYPTION_KEY is set, also derives the key that encrypts OAuth access tokens.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=""

# Optional. Overrides the key used to encrypt stored OAuth tokens. Set this when rotating
# SESSION_SECRET, so existing encrypted tokens stay readable.
TOKEN_ENCRYPTION_KEY=""

# --- OAuth ------------------------------------------------------------------
# The two CLIENTID values are duplicated as EXPO_PUBLIC_* because the mobile client has to
# start the authorization request without talking to the server. Keep both in sync.

EXPO_PUBLIC_OAUTH_42_CLIENTID=""
OAUTH_42_SECRET=""

EXPO_PUBLIC_OAUTH_GOOGLE_CLIENTID=""
OAUTH_GOOGLE_SECRET=""

# Public origin of the API, used to build the OAuth redirect URIs and the links inside
# verification and password reset emails.
EXPO_PUBLIC_BASE_URL="http://localhost:3000"

# --- Email ------------------------------------------------------------------
# Leave SMTP_USER and SMTP_PASS empty to skip sending mail. Nothing else changes: the
# tokens are still written to the console and stored, so verification and reset flows
# remain testable without a mail server.

SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Music Room <noreply@music-room.local>"

# --- Clients ----------------------------------------------------------------
# Used for the CORS allow list and for the links in emails.

CLIENT_URL_WEB="http://localhost:8081"
CLIENT_URL_MOBILE="exp://localhost:8081"

# --- Server -----------------------------------------------------------------

PORT=3000
NODE_ENV="development"

# Optional. Upper bound on the Prisma connection pool, per server process. The embedded
# Postgres used for local development accepts a single client at a time, so a pool larger
# than 1 leaves dead sockets behind and the server starts answering 501 on every query.
# Keep it at 1 for the embedded DB, raise it for a real Postgres. Only one process may talk
# to the embedded DB at a time: stop your dev server before running a script that opens its
# own client (seed, prisma studio, tests).
DATABASE_POOL_MAX=1

# Optional. Only read by the benchmark script (npm run bench). Point it at a server that
# is not your development one before running a load test.
# BENCH_BASE_URL="http://localhost:3000/api"
