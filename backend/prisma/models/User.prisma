model User {
  id                String         @id @default(uuid())
  email             String         @unique
  username          String
  passwordHash      String?
  avatarUrl         String?
  emailVerified     Boolean        @default(false)
  deezerUserId      String?        @unique
  deezerAccessToken String?
  fortytwoOauthId   String?        @unique
  fortytwoUserId    Int?           @unique
  googleOauthId     String?        @unique
  createdAt         DateTime       @default(now())
  follows           Follow[]       @relation("follower")
  followers         Follow[]       @relation("following")
  likes             Like[]
  plays             PlayHistory[]
  fortytwoOauth     FortytwoOauth? @relation(fields: [fortytwoOauthId], references: [id], onDelete: Cascade)
  googleOauth       GoogleOauth?   @relation(fields: [googleOauthId], references: [id], onDelete: Cascade)
  playlist          Playlist[]     @relation("PlaylistToUser")
  ownedEvents       MusicEvent[]   @relation("EventOwner")
  eventMemberships  MusicEventMember[]
  playlistMemberships PlaylistMember[]
  devices           Device[]
  sessionExchanges  SessionExchange[]
  musicPreference   MusicPreference?
  profileVisibility ProfileVisibility[]
  oauthStates       OauthState[]

  @@map("users")
}
