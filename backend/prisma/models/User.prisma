model User {
  id                    String      @id @default(cuid())
  email                 String      @unique
  username              String
  passwordHash          String?
  avatarUrl             String?

  deezerUserId          String?     @unique
  deezerAccessToken     String?
  
  fortytwo_oauth_id			String?			@unique
  fortytwo_user_id      Int?        @unique

  google_oauth_id			  String?			@unique

  createdAt             DateTime    @default(now())

  playlists               Playlist[]
  likes                   Like[]
  plays                   PlayHistory[]
  follows                 Follow[]            @relation("follower")
  followers               Follow[]            @relation("following")
  fortytwo_oauth				  fortytwo_oauth?			@relation(fields: [fortytwo_oauth_id], references: [id], onDelete: Cascade)
  google_oauth				    Google_oauth?			  @relation(fields: [google_oauth_id], references: [id], onDelete: Cascade)

  @@map("users")
}