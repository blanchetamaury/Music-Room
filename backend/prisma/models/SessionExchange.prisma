model SessionExchange {
  id String @id @default(uuid())

  userId String

  codeHash String @unique

  clientType String?

  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session_exchanges")
}
