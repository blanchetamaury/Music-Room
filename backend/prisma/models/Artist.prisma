model Artist {
	id          		String   @id @default(cuid())
	
	deezerCUID   		String
	name     			String
	pictureSmall  		String?
	pictureMedium 		String?
	pictureBig  		String?
	nbFan				Int
	nbAlbum				Int

	tracks      		Track[]
	album				Album[]

	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt
}